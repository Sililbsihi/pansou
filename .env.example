# ============ Supabase（必填，用于真实数据存储） ============
# Supabase 项目地址，形如 https://xxxxx.supabase.co
SUPABASE_URL=
# anon 公钥（只用于服务端读写走 RLS）
SUPABASE_ANON_KEY=
# service_role 私钥【绝密】只在本项目服务端使用，绝不暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=

# ============ 资源数据源（方案A：PanSou 聚合 API） ============
# PanSou 服务地址，形如 https://你的域名或IP:8888
# 留空时网站自动进入演示模式（内置示例数据，便于预览）
# 自部署：docker run -d --name pansou -p 8888:8888 ghcr.io/fish2018/pansou:latest
SOURCE_API_URL=
# 若 PanSou 开启了 AUTH_ENABLED 认证，填写登录账号密码生成的 token（一般留空）
SOURCE_API_TOKEN=

# ============ 安全密钥（必填，随机字符串，防止接口被滥用） ============
# Vercel 定时任务调用 /api/cron/sync 时自动携带的密钥
CRON_SECRET=
# 管理接口 /api/admin/* 的访问密钥
ADMIN_TOKEN=

# ============ 站点信息（可选） ============
# 线上地址，部署后填 https://你的项目.vercel.app，用于 SEO 与站内跳转
NEXT_PUBLIC_SITE_URL=
# 站点名称，默认“盘搜”
SITE_NAME=
